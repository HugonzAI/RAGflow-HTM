# =============================================================
# RAGFlow-HTM Environment Configuration — EXAMPLE
# =============================================================
# Copy this file to .env and change the passwords!
#   cp .env.example .env

RAGFLOW_IMAGE=infiniflow/ragflow:v0.24.0
TZ=UTC
DOC_ENGINE=elasticsearch
DEVICE=cpu

# --- Passwords (MUST change for production) ---
ELASTIC_PASSWORD=<your-strong-password>
MYSQL_PASSWORD=<your-strong-password>
MINIO_USER=rag_flow
MINIO_PASSWORD=<your-strong-password>
REDIS_PASSWORD=<your-strong-password>

# --- Ports ---
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ES_PORT=1200
EXPOSE_MYSQL_PORT=5455
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# --- Document Processing ---
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16
MYSQL_MAX_PACKET=1073741824
MEM_LIMIT=8073741824
