# =============================================================
# RAGFlow-HTM — Environment Configuration
# =============================================================
# Copy this file into the RAGFlow docker/ directory as .env:
#   cp .env.example /path/to/ragflow/docker/.env
#
# Then edit the passwords before starting services.

RAGFLOW_IMAGE=infiniflow/ragflow:v0.24.0
TZ=UTC
DOC_ENGINE=elasticsearch

# --- Passwords (MUST change before use) ---
ELASTIC_PASSWORD=<your-password>
MYSQL_PASSWORD=<your-password>
MINIO_USER=rag_flow
MINIO_PASSWORD=<your-password>
REDIS_PASSWORD=<your-password>

# --- Ports ---
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ES_PORT=1200
EXPOSE_MYSQL_PORT=5455
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# --- Document Processing ---
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16
MYSQL_MAX_PACKET=1073741824
MEM_LIMIT=8073741824
